# Postgres connection string.
# In production this is auto-injected when you connect a Neon database
# to your Vercel project (Storage tab → Create Database → Neon).
# Vercel typically sets DATABASE_URL; older projects may use POSTGRES_URL.
# Only needed locally if you want to run `vercel dev` against a real database;
# `vercel env pull` will write a .env.development.local file for you.
DATABASE_URL=

# Password used to view RSVPs at /api/admin?key=YOUR_PASSWORD.
# Pick anything you can remember — it never leaves your URL bar.
ADMIN_PASSWORD=
