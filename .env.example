# Google Sheets integration for the RSVP endpoint.
# Create a service account in Google Cloud, enable the Google Sheets API,
# download the JSON key, and share the target Sheet with the service account
# email (Editor access). Then set these three env vars in Vercel.

# The ID from the Sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Service account "client_email" from the JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account "private_key" from the JSON key.
# IMPORTANT: Paste the key with literal \n escapes for newlines (one single line).
# The server runtime un-escapes them with .replace(/\\n/g, '\n').
# Example format (all one line, quoted):
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
